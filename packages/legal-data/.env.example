# Supabase (free tier project -> Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose client-side

# Groq (free tier -> console.groq.com/keys) - used later by the chatbot/analysis agents
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (runs 100% locally, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hard-RAG similarity threshold (per compliance matrix, section 6 of spec)
RAG_SIMILARITY_THRESHOLD=0.75
